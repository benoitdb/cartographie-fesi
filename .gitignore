# Données
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
# Enrichissement Wikidata (region_metadata.py) : contrairement à data.json, pas régénéré à
# chaque ingest.py, stable dans le temps et nécessite un accès réseau — committé pour que
# le dashboard tourne sans dépendance externe.
!data/processed/region_metadata.json
# Totaux programmés (Tableau 9B, reference/programmes_2021_2027.py) : dérivé uniquement de
# fichiers déjà committés, aucun appel réseau — committé pour la même raison.
!data/processed/programme_totals.json
# Détail FTJ Article 3/4 + assistance technique (même source, même script programme_totals.py) :
# committé pour la même raison.
!data/processed/programme_detail.json
# Dotations par objectif stratégique (Tableau 8, reference/dotations_os.py) : dérivé uniquement
# de fichiers déjà committés, aucun appel réseau — committé pour la même raison.
!data/processed/dotations_os.json
# Liste des programmes Interreg (Tableau 10, reference/interreg.py) : même raison.
!data/processed/interreg.json
# Catégories de région 2014-2020 (décision 2014/99, reference/cohesion_ue_2014_2020.py, via
# categories_ue_2014_2020.py) : même raison. C'est ce fichier qui porte les plafonds de
# cofinancement de la période à l'écran (issue #81) — non committé, la page 2014-2020
# tomberait sur un clone nu.
!data/processed/categories_ue_2014_2020.json
# Profils de source par période (profil_source.py) : photo factuelle de la donnée
# (volumétrie, complétude, périmètre) affichée par la page « Validation de la source ».
# Dérivé du XLSX brut — non committé, donc non régénérable sur un clone nu — d'où
# le versionnement du profil, pour que la page tourne sans le fichier source.
!data/processed/profil_*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Documents de référence externes (guides, vademecum...) partagés en session : notes de
# travail utiles localement, pas du contenu du dépôt à versionner.
docs/sources/
