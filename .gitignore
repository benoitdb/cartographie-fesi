# Données
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
# Enrichissement Wikidata (region_metadata.py) : contrairement à data.json, pas régénéré à
# chaque ingest.py, stable dans le temps et nécessite un accès réseau — committé pour que
# le dashboard tourne sans dépendance externe.
!data/processed/region_metadata.json
# Totaux programmés (Tableau 9B, reference/programmes_2021_2027.py) : dérivé uniquement de
# fichiers déjà committés, aucun appel réseau — committé pour la même raison.
!data/processed/programme_totals.json
# Détail FTJ Article 3/4 + assistance technique (même source, même script programme_totals.py) :
# committé pour la même raison.
!data/processed/programme_detail.json
# Dotations par objectif stratégique (Tableau 8, reference/dotations_os.py) : dérivé uniquement
# de fichiers déjà committés, aucun appel réseau — committé pour la même raison.
!data/processed/dotations_os.json

